[Unit]
Description=LiteLLM Proxy Stack (nginx + litellm-proxy + postgres)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=mdawkins
WorkingDirectory=/home/mdawkins/Build/Containers/LiteLLMContainer

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

ExecStartPre=/usr/bin/bash /home/mdawkins/Build/Containers/LiteLLMContainer/gen-env.sh
ExecStart=/usr/bin/podman-compose -f compose-litellm.yaml up -d --build
ExecStop=/usr/bin/podman-compose -f compose-litellm.yaml down

Restart=no
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
